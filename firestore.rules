rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if self(uid);
      allow create, update: if self(uid) && request.resource.data.role in ['Student','Staff','Worker'];
      allow delete: if false;
    }
    match /reports/{id} {
      allow read: if signedIn() && (resource.data.visibility != 'private' || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (resource.data.ownerUid == request.auth.uid);
      allow delete: if false;
    }
    match /notifications/{id} { allow read, update: if signedIn() && resource.data.uid == request.auth.uid; allow create: if false; allow delete: if false; }
    match /matches/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read: if false; allow write: if false; }
  }
}
